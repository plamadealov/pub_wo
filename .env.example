# Скопируйте в .env в корне проекта или в backend/.env (файл не коммитится).
# Продакшн / Netlify + прямой вызов API из браузера (без rewrite): список origin через запятую.
# ALLOW_ORIGINS=https://your-site.netlify.app,https://www.example.com
# Рекомендуется указать контакт для User-Agent при запросах к MOEX ISS:
# MOEX_ISS_USER_AGENT=your-app/0.1 (your@email)
# TINVEST_TOKEN=
# NEWS_API_KEY=          # опционально: NewsAPI.org (иначе — RSS Google News)
# NEWS_HTTP_USER_AGENT=  # опционально: заголовок для запросов к агрегаторам
